<Window x:Class="FitnessClub.ClientMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Личный кабинет"
        Width="1160" Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}"
                                   Margin="18,0"/>
                        <TextBlock Text="Личный кабинет клиента"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="UserText"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Обновить" Style="{StaticResource GhostButton}"
                                Margin="18,0,0,0" Click="Refresh_Click"/>
                        <Button Content="Выход" Style="{StaticResource GhostButton}"
                                Margin="6,0,10,0" Click="Logout_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,28,36,28">

                    <TextBlock x:Name="GreetingText" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="MembershipText" Style="{StaticResource Muted}"
                               FontSize="14" Margin="0,8,0,0"/>

                    <UniformGrid Columns="4" Margin="0,24,0,0">
                        <Button Style="{StaticResource TileButton}"
                                Tag="Schedule" Click="Tile_Click">
                            <StackPanel>
                                <TextBlock Text="01" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                <TextBlock Text="Расписание" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                <TextBlock Text="Ближайшие тренировки" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}"
                                Tag="Bookings" Click="Tile_Click">
                            <StackPanel>
                                <TextBlock Text="02" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                <TextBlock Text="Мои записи" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                <TextBlock Text="Запланированные занятия" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}"
                                Tag="Membership" Click="Tile_Click">
                            <StackPanel>
                                <TextBlock Text="03" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                <TextBlock Text="Мой абонемент" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                <TextBlock Text="Срок действия и оплата" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileButton}" Margin="0"
                                Tag="History" Click="Tile_Click">
                            <StackPanel>
                                <TextBlock Text="04" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource AccentHoverBrush}"/>
                                <TextBlock Text="История" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                                <TextBlock Text="Посещения и отметки" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Margin="0,30,0,12">
                        <TextBlock Text="Ближайшие занятия" Style="{StaticResource H2}"/>
                        <Button Content="Всё расписание" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Click="OpenSchedule_Click"/>
                    </Grid>

                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <ItemsControl x:Name="LessonsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="18,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="230"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding When}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AccentSoftBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Trainer}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Hall}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Seats}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,14,0"/>
                                                <Button Content="{Binding ButtonText}"
                                                        Style="{StaticResource SmallAccentButton}"
                                                        Tag="{Binding Id}"
                                                        IsEnabled="{Binding CanBook}"
                                                        Click="Book_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock x:Name="FooterText"
                               Style="{StaticResource Muted}" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
