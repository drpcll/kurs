<Window x:Class="FitnessClub.AdminMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Панель администратора"
        Width="1240" Height="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}"
                                   Margin="18,0"/>
                        <TextBlock Text="Администрирование"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="UserText"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Обновить" Style="{StaticResource GhostButton}"
                                Margin="18,0,0,0" Click="Refresh_Click"/>
                        <Button Content="Выход" Style="{StaticResource GhostButton}"
                                Margin="6,0,10,0" Click="Logout_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Row="1" Margin="36,24,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Панель администратора" Style="{StaticResource H1}"/>
                    <TextBlock Text="Клиенты, абонементы и расписание клуба"
                               Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,0">
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock x:Name="ClientCountText" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentSoftBrush}"/>
                            <TextBlock Text="клиентов" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock x:Name="MembershipCountText" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentSoftBrush}"/>
                            <TextBlock Text="действующих абонементов" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,14" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock x:Name="LessonCountText" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentSoftBrush}"/>
                            <TextBlock Text="занятий в расписании" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            Padding="20,14">
                        <StackPanel>
                            <TextBlock x:Name="TrainerCountText" Text="0" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentSoftBrush}"/>
                            <TextBlock Text="тренеров" Style="{StaticResource Muted}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,16,0,0">
                    <Button Style="{StaticResource TileButton}" Height="82"
                            Tag="Clients" Click="Tile_Click">
                        <StackPanel>
                            <TextBlock Text="Клиенты" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Карточки и контакты" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Height="82"
                            Tag="Memberships" Click="Tile_Click">
                        <StackPanel>
                            <TextBlock Text="Абонементы" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Оформление и продление" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Height="82"
                            Tag="Schedule" Click="Tile_Click">
                        <StackPanel>
                            <TextBlock Text="Расписание" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Занятия и залы" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TileButton}" Height="82" Margin="0"
                            Tag="Reports" Click="Tile_Click">
                        <StackPanel>
                            <TextBlock Text="Отчёты" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Посещаемость и продажи" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Grid Grid.Row="3" Margin="0,22,0,10">
                    <TextBlock Text="Клиенты клуба" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}"
                                 Width="240" Height="34" VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Content="Найти" Style="{StaticResource SecondaryButton}"
                                Height="34" Margin="8,0,0,0" Click="Search_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource GhostButton}"
                                Height="34" Margin="6,0,0,0" Click="ResetSearch_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="4"
                          x:Name="ClientsGrid"
                          Style="{StaticResource DarkDataGrid}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Фамилия" Binding="{Binding Familiya}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Imya}"
                                            Width="130"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Telefon}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Абонемент" Binding="{Binding Abonement}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding Login}"
                                            Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="5" x:Name="FooterText" Style="{StaticResource Muted}"
                           Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
