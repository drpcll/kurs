<Window x:Class="FitnessClub.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Запись на занятие"
        Width="620" Height="660"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderBrush}" Margin="14,0"/>
                        <TextBlock Text="Запись на занятие" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="36,28,36,28">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" FontSize="25"/>
                <TextBlock x:Name="WhenText" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,20"/>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Тренер" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TrainerText" Grid.Column="1" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="Зал" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HallText" Grid.Row="1" Grid.Column="1" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="Свободные места" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SeatsText" Grid.Row="2" Grid.Column="1" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Text="Ваш абонемент" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MembershipText" Grid.Row="3" Grid.Column="1" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border x:Name="WarningBorder" Background="#2A1A1F" BorderBrush="#5A2432"
                        BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WarningText" FontSize="12"
                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="ErrorText" FontSize="12"
                           Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,12,0,0"/>

                <Button x:Name="BookButton" Content="Записаться"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0" Click="Book_Click"/>

                <Button Content="Отмена" Style="{StaticResource GhostButton}"
                        Height="40" Margin="0,8,0,0" Click="Cancel_Click"/>

                <TextBlock Text="Отменить запись можно в разделе «Мои записи» не позднее начала занятия."
                           Style="{StaticResource Muted}" FontSize="10"
                           TextAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
