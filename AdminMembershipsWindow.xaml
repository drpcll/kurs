<Window x:Class="FitnessClub.AdminMembershipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Абонементы"
        Width="1240" Height="840"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="18,0"/>
                        <TextBlock Text="Абонементы" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Назад" Style="{StaticResource GhostButton}"
                                Margin="18,0,10,0" Click="Back_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,22,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Абонементы клиентов" Style="{StaticResource H1}" FontSize="26"/>
                    <TextBlock Text="Оформление нового абонемента и продление действующего."
                               Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,16,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Клиент" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ClientCombo" Grid.Column="1" Style="{StaticResource ComboInput}"
                                  DisplayMemberPath="Fio" SelectedValuePath="Id"/>

                        <TextBlock Grid.Column="2" Text="Тип абонемента" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox x:Name="TypeCombo" Grid.Column="3" Style="{StaticResource ComboInput}"
                                  DisplayMemberPath="Nazvanie" SelectedValuePath="Id"/>

                        <TextBlock Grid.Column="4" Text="Начало" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <TextBox x:Name="StartBox" Grid.Column="5" Style="{StaticResource InputBox}"
                                 Height="38" VerticalContentAlignment="Center"/>

                        <Button Grid.Column="6" Content="Оформить"
                                Style="{StaticResource PrimaryButton}" Height="38" Width="130"
                                Margin="14,0,0,0" Click="Issue_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Поиск" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                 Height="34" VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"/>

                        <TextBlock Grid.Column="2" Text="Статус" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox x:Name="StatusCombo" Grid.Column="3" Style="{StaticResource ComboInput}"
                                  Height="34">
                            <ComboBoxItem Content="Все"/>
                            <ComboBoxItem Content="Действует"/>
                            <ComboBoxItem Content="Истёк"/>
                        </ComboBox>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0">
                            <Button Content="Показать" Style="{StaticResource SecondaryButton}"
                                    Height="34" Width="110" Click="Filter_Click"/>
                            <Button Content="Сбросить" Style="{StaticResource GhostButton}"
                                    Height="34" Width="100" Margin="6,0,0,0" Click="Reset_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="3" x:Name="MembershipGrid" Style="{StaticResource DarkDataGrid}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                        <DataGridTextColumn Header="Тип абонемента" Binding="{Binding Type}" Width="220"/>
                        <DataGridTextColumn Header="Начало" Binding="{Binding StartText}" Width="110"/>
                        <DataGridTextColumn Header="Окончание" Binding="{Binding EndText}" Width="110"/>
                        <DataGridTextColumn Header="Стоимость" Binding="{Binding CostText}" Width="110"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock x:Name="FooterText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Продлить выбранный" Style="{StaticResource SecondaryButton}"
                                Height="34" Click="Extend_Click"/>
                        <Button Content="Обновить" Style="{StaticResource GhostButton}"
                                Height="34" Margin="6,0,0,0" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
