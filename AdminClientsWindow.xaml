<Window x:Class="FitnessClub.AdminClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Клиенты"
        Width="1240" Height="860"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="18,0"/>
                        <TextBlock Text="Клиенты" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Назад" Style="{StaticResource GhostButton}"
                                Margin="18,0,10,0" Click="Back_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,22,32,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Клиенты клуба" Style="{StaticResource H1}" FontSize="26"/>
                        <TextBlock Text="Добавление, редактирование и удаление карточек клиентов."
                                   Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,16,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Поиск" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                 Height="34" VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Button Grid.Column="2" Content="Найти" Style="{StaticResource SecondaryButton}"
                                Height="34" Margin="8,0,0,0" Click="Search_Click"/>
                        <Button Grid.Column="3" Content="Сбросить" Style="{StaticResource GhostButton}"
                                Height="34" HorizontalAlignment="Left" Margin="6,0,0,0"
                                Click="ResetSearch_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="370"/>
                    </Grid.ColumnDefinitions>

                    <DataGrid x:Name="ClientsGrid" Style="{StaticResource DarkDataGrid}"
                              SelectionChanged="ClientsGrid_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding Familiya}" Width="140"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Imya}" Width="120"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Telefon}" Width="145"/>
                            <DataGridTextColumn Header="Абонемент" Binding="{Binding Abonement}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="115"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="20,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="FormTitle" Text="Новый клиент"
                                           Style="{StaticResource H2}" FontSize="17"/>

                                <TextBlock Text="Фамилия" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                                <TextBox x:Name="FamiliyaBox" Style="{StaticResource InputBox}" Height="34"/>

                                <TextBlock Text="Имя" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox x:Name="ImyaBox" Style="{StaticResource InputBox}" Height="34"/>

                                <TextBlock Text="Телефон" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox x:Name="TelefonBox" Style="{StaticResource InputBox}" Height="34"/>

                                <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <TextBox x:Name="LoginBox" Style="{StaticResource InputBox}" Height="34"/>

                                <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" Height="34"/>
                                <TextBlock x:Name="PasswordHint" Text="При редактировании оставьте пустым, чтобы не менять."
                                           Style="{StaticResource Muted}" FontSize="10" Margin="2,4,0,0"
                                           Visibility="Collapsed"/>

                                <Button x:Name="AddButton" Content="Добавить клиента"
                                        Style="{StaticResource PrimaryButton}" Height="40"
                                        Margin="0,18,0,0" Click="Add_Click"/>

                                <Button x:Name="SaveButton" Content="Сохранить изменения"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        Margin="0,8,0,0" Click="Save_Click" IsEnabled="False"/>

                                <Button x:Name="DeleteButton" Content="Удалить клиента"
                                        Style="{StaticResource DangerButton}" Height="38"
                                        Margin="0,8,0,0" Click="Delete_Click" IsEnabled="False"/>

                                <Button Content="Очистить форму" Style="{StaticResource GhostButton}"
                                        Height="36" Margin="0,4,0,0" Click="Clear_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="3" x:Name="FooterText" Style="{StaticResource Muted}"
                           Margin="0,10,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
