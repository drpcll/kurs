<Window x:Class="FitnessClub.LessonEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Занятие"
        Width="620" Height="700"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderBrush}" Margin="14,0"/>
                        <TextBlock Text="Занятие" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="36,26,36,26">
                <TextBlock x:Name="FormTitle" Text="Добавление занятия"
                           Style="{StaticResource H1}" FontSize="25"/>

                <TextBlock Text="Название" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <TextBox x:Name="TitleBox" Style="{StaticResource InputBox}" Height="40"/>

                <TextBlock Text="Тренер" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox x:Name="TrainerCombo" Style="{StaticResource ComboInput}"
                          DisplayMemberPath="Familiya" SelectedValuePath="Id"/>

                <TextBlock Text="Зал" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <ComboBox x:Name="HallCombo" Style="{StaticResource ComboInput}"
                          DisplayMemberPath="Nazvanie" SelectedValuePath="Id"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Дата" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DateBox" Style="{StaticResource InputBox}" Height="40"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TimeBox" Style="{StaticResource InputBox}" Height="40"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Формат даты: дд.мм.гггг, времени: ЧЧ:ММ"
                           Style="{StaticResource Muted}" FontSize="10" Margin="2,4,0,0"/>

                <TextBlock x:Name="ErrorText" FontSize="12"
                           Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,12,0,0"/>

                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                        Margin="0,20,0,0" Click="Save_Click"/>

                <Button Content="Отмена" Style="{StaticResource GhostButton}"
                        Height="40" Margin="0,8,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
