<Window x:Class="FitnessClub.AdminScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Расписание (администратор)"
        Width="1300" Height="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="18,0"/>
                        <TextBlock Text="Расписание — администратор" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Назад" Style="{StaticResource GhostButton}"
                                Margin="18,0,10,0" Click="Back_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,20,32,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="360"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Расписание занятий" Style="{StaticResource H1}" FontSize="26"/>
                    <TextBlock Text="Добавление, изменение и удаление занятий; отметки о посещении."
                               Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,14,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="С даты" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FromBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                 Height="34" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="По дату" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <TextBox x:Name="ToBox" Grid.Column="3" Style="{StaticResource InputBox}"
                                 Height="34" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="4" Text="Зал" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="14,0,8,0"/>
                        <ComboBox x:Name="HallCombo" Grid.Column="5" Style="{StaticResource ComboInput}"
                                  Height="34" DisplayMemberPath="Nazvanie" SelectedValuePath="Id"/>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="14,0,0,0">
                            <Button Content="Показать" Style="{StaticResource SecondaryButton}"
                                    Height="34" Width="105" Click="Apply_Click"/>
                            <Button Content="Сбросить" Style="{StaticResource GhostButton}"
                                    Height="34" Width="95" Margin="6,0,0,0" Click="Reset_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Добавить занятие" Style="{StaticResource PrimaryButton}"
                                Height="36" Width="160" Click="Add_Click"/>
                        <Button Content="Изменить" Style="{StaticResource SecondaryButton}"
                                Height="36" Width="110" Margin="8,0,0,0" Click="Edit_Click"/>
                        <Button Content="Удалить" Style="{StaticResource DangerButton}"
                                Height="36" Width="100" Margin="8,0,0,0" Click="Delete_Click"/>
                    </StackPanel>
                    <Button Content="Обновить" Style="{StaticResource GhostButton}"
                            Height="36" HorizontalAlignment="Right" Click="Refresh_Click"/>
                </Grid>

                <DataGrid Grid.Row="3" x:Name="LessonsGrid" Style="{StaticResource DarkDataGrid}"
                          SelectionChanged="LessonsGrid_SelectionChanged"
                          MouseDoubleClick="LessonsGrid_MouseDoubleClick"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="100"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="75"/>
                        <DataGridTextColumn Header="Занятие" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Тренер" Binding="{Binding Trainer}" Width="125"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding Hall}" Width="190"/>
                        <DataGridTextColumn Header="Записано" Binding="{Binding Seats}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="4" Margin="0,12,0,8">
                    <TextBlock x:Name="BookingsTitle" Text="Записи на выбранное занятие"
                               Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Пришёл" Style="{StaticResource SecondaryButton}"
                                Height="30" Padding="12,0" Click="MarkCame_Click"/>
                        <Button Content="Не пришёл" Style="{StaticResource DangerButton}"
                                Height="30" Padding="12,0" Margin="6,0,0,0" Click="MarkMissed_Click"/>
                        <Button Content="Записан" Style="{StaticResource GhostButton}"
                                Height="30" Margin="6,0,0,0" Click="MarkBooked_Click"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="5" x:Name="BookingsGrid" Style="{StaticResource DarkDataGrid}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding Client}" Width="*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="160"/>
                        <DataGridTextColumn Header="Отметка" Binding="{Binding Mark}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="6" x:Name="FooterText" Style="{StaticResource Muted}"
                           Margin="0,8,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
