<Window x:Class="FitnessClub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Вход"
        Width="960" Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Брендовая панель -->
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7A1F3D" Offset="0"/>
                        <GradientStop Color="#43131F" Offset="0.55"/>
                        <GradientStop Color="#141418" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="46">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <Rectangle Height="3" Width="64" Fill="{StaticResource AccentSoftBrush}"
                                   HorizontalAlignment="Left" Margin="0,18,0,18"/>
                        <TextBlock Text="Информационно-справочная система"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="16" Foreground="{StaticResource AccentSoftBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Расписание · Абонементы · Запись на занятия"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="#D9B9C4"
                                   TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Курсовой проект · 2026"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11" Foreground="#B98C9A"
                               VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Форма входа -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Button Content="✕"
                            Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Click="Close_Click"/>
                </Border>

                <StackPanel Grid.Row="1" Width="360"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="Вход в систему" Style="{StaticResource H1}"/>
                    <TextBlock Text="Введите логин и пароль, чтобы продолжить"
                               Style="{StaticResource Muted}" Margin="0,8,0,28"/>

                    <TextBlock Text="Логин" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LoginBox"
                             Style="{StaticResource InputBox}"
                             Height="46"
                             KeyDown="LoginBox_KeyDown"/>

                    <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource PasswordInput}"
                                 Height="46"
                                 KeyDown="PasswordBox_KeyDown"/>

                    <TextBlock x:Name="ErrorText"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="0,12,0,0"/>

                    <Button Content="Войти"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,22,0,0"
                            Click="Login_Click"/>

                    <Button Content="Регистрация"
                            Style="{StaticResource GhostButton}"
                            Height="42" FontSize="14"
                            Margin="0,10,0,0"
                            Click="Register_Click"/>

                    <TextBlock Text="Демонстрационный доступ: admin / admin или client / client"
                               Style="{StaticResource Muted}"
                               TextAlignment="Center"
                               Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
