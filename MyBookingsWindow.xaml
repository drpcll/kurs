<Window x:Class="FitnessClub.MyBookingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Мои записи"
        Width="1120" Height="740"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="18,0"/>
                        <TextBlock Text="Мои записи" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Назад" Style="{StaticResource GhostButton}"
                                Margin="18,0,10,0" Click="Back_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Запланированные занятия" Style="{StaticResource H1}" FontSize="26"/>
                        <TextBlock Text="Здесь отображаются ваши будущие записи. Отменить можно запись до начала занятия."
                                   Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Content="Обновить" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Click="Refresh_Click"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="BookingsGrid" Style="{StaticResource DarkDataGrid}"
                          Margin="0,18,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="105"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="75"/>
                        <DataGridTextColumn Header="Занятие" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Тренер" Binding="{Binding Trainer}" Width="125"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding Hall}" Width="180"/>
                        <DataGridTextColumn Header="Отметка" Binding="{Binding Status}" Width="110"/>
                        <DataGridTemplateColumn Header="" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Отменить"
                                            Style="{StaticResource DangerButton}"
                                            Height="30" FontSize="12" Padding="12,0"
                                            Tag="{Binding LessonId}"
                                            IsEnabled="{Binding CanCancel}"
                                            Click="Cancel_Click"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" x:Name="CountText" Style="{StaticResource Muted}"
                           Margin="0,12,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
