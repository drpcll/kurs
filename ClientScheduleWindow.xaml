<Window x:Class="FitnessClub.ClientScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фитнес-клуб — Расписание занятий"
        Width="1180" Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ФИТНЕС-КЛУБ" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource AccentSoftBrush}"/>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="18,0"/>
                        <TextBlock Text="Расписание занятий" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" FontSize="13"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button Content="Назад" Style="{StaticResource GhostButton}"
                                Margin="18,0,10,0" Click="Back_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="Back_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Расписание занятий" Style="{StaticResource H1}" FontSize="26"/>
                    <TextBlock Text="Выберите занятие и запишитесь. Доступны только будущие занятия со свободными местами."
                               Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="145"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="С даты" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FromBox" Grid.Column="1" Style="{StaticResource InputBox}"
                                 Height="36" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="2" Text="По дату" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox x:Name="ToBox" Grid.Column="3" Style="{StaticResource InputBox}"
                                 Height="36" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Column="4" Text="Зал" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <ComboBox x:Name="HallCombo" Grid.Column="5" Style="{StaticResource ComboInput}"
                                  DisplayMemberPath="Nazvanie" SelectedValuePath="Id"/>

                        <Button Grid.Column="6" Content="Показать" Style="{StaticResource PrimaryButton}"
                                Height="36" Width="120" Margin="16,0,0,0" Click="Apply_Click"/>
                        <Button Grid.Column="7" Content="Сбросить" Style="{StaticResource SecondaryButton}"
                                Height="36" Width="110" HorizontalAlignment="Left" Margin="10,0,0,0"
                                Click="Reset_Click"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2" x:Name="LessonsGrid" Style="{StaticResource DarkDataGrid}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="100"/>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="75"/>
                        <DataGridTextColumn Header="Занятие" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Тренер" Binding="{Binding Trainer}" Width="120"/>
                        <DataGridTextColumn Header="Зал" Binding="{Binding Hall}" Width="170"/>
                        <DataGridTextColumn Header="Записано" Binding="{Binding Seats}" Width="100"/>
                        <DataGridTemplateColumn Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ButtonText}"
                                            Style="{StaticResource SmallAccentButton}"
                                            Tag="{Binding Id}"
                                            IsEnabled="{Binding CanBook}"
                                            Click="Book_Click"
                                            HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="3" x:Name="CountText" Style="{StaticResource Muted}"
                           Margin="0,12,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
